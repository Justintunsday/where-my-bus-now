"tracking.foregroundNotice": {
    "localizations": {
      "en": {
        "stringUnit": {
          "value": "Arrival predictions refresh while this app is open. The countdown uses the last received prediction. A * marks minutes at the displayed update time. After 90 seconds, or when that bus is due, open the app to refresh. Background push updates are not connected yet.",
          "state": "translated"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "value": "到站预测会在 App 打开时更新。倒计时使用最后收到的预测。* 表示所示更新时间的分钟数；90 秒后或预计到站时，请打开 App 更新。目前尚未连接后台推送。",
          "state": "translated"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "value": "到站預測會在 App 開啟時更新。倒數使用最後收到的預測。* 表示所示更新時間的分鐘數；90 秒後或預計到站時，請開啟 App 更新。目前尚未連接背景推送。",
          "state": "translated"
        }
      }
    }
  },
