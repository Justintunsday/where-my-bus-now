        "en" : { "stringUnit" : { "state" : "translated", "value" : "CheLaile API is the primary mainland source. AMap is used only as an official base-data fallback when configured; legacy direct CheLaile is the final fallback. All data is for reference only." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "內地主接口為車來了 API；設定 AMAP_WEB_SERVICE_KEY 後，高德僅作官方基礎資料後備，舊車來了直連為最終後備。資料僅供參考。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "内地主接口为车来了 API；配置 AMAP_WEB_SERVICE_KEY 后，高德仅作官方基础数据备用，旧车来了直连为最终备用。数据仅供参考。" } }
