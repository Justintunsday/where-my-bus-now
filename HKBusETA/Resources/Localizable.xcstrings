      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Realtime ETA uses the CheLaile API primary. If it fails, the legacy direct API is used; AMap is never presented as realtime." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "實時到站由車來了 API 主接口提供；失敗時使用舊車來了直連後備，高德不會被標示為實時數據。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "实时到站由车来了 API 主接口提供；失败时使用旧车来了直连备用，高德不会被标示为实时数据。" } }
