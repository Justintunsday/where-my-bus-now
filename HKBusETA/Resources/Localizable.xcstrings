    "tracking.previewDisclosure" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared layout preview. The system controls the actual Island shape, margins and update animations. Countdown ticks are not new operator data."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共用佈局預覽。實際靈動島外形、邊距與更新動畫由系統控制；倒數跳動不代表收到新的營運商資料。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共用布局预览。实际灵动岛外形、边距与更新动画由系统控制；倒数跳动不代表收到新的运营商数据。"
          }
        }
      }
    },
